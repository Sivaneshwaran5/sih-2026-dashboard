{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run AI Edge Simulation (video_detector.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ai_engine/video_detector.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Run FastAPI Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "console": "integratedTerminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}"
        }
    ]
}